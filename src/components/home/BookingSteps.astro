---
import TwoLineTitle from '../ui/TwoLineTitle.astro';
// «Seis pasos, sin llamadas» band: the six steps of the approved booking (CLAUDE.md §5).
import { Image } from 'astro:assets';
import aceitunas from '../../assets/images/aceitunas-tablas.jpg';
import Button from '../ui/Button.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const steps = [1, 2, 3, 4, 5, 6] as const;
---

<section id="como-funciona" class="silver band" aria-labelledby="pasos-title">
  <Image
    src={aceitunas}
    alt={t('home.steps.alt')}
    widths={[640, 960, 1280]}
    sizes="(max-width: 1080px) 100vw, 50vw"
    loading="lazy"
    class="photo"
    data-reveal="left"
  />
  <div class="body">
    <div class="head" data-reveal="left">
      <p class="eyebrow">{t('home.steps.eyebrow')}</p>
      <h2 id="pasos-title"><TwoLineTitle text={t('home.steps.title')} /></h2>
    </div>
    <ol data-reveal="up" data-reveal-delay="1">
      {
        steps.map((n) => (
          <li>
            <span class="num serif" aria-hidden="true">
              {String(n).padStart(2, '0')}
            </span>
            <div>
              <h3>{t(`home.steps.s${n}Title`)}</h3>
              <p>
                {t(`home.steps.s${n}Text`)}
                {n === 5 && (
                  <>
                    {' '}
                    <a href="#extras">{t('home.steps.s5Link')}</a>
                  </>
                )}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="secure">
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="4" y="11" width="16" height="10" rx="2"></rect>
        <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
      </svg>
      <span><strong>{t('home.steps.secureStrong')}</strong> {t('home.steps.secureText')}</span>
    </p>
    <Button href={localizePath('/reserva', lang)}>{t('home.steps.cta')}</Button>
  </div>
</section>

<style>
  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    color: var(--text);
  }

  .photo {
    flex: 1 1 520px;
    min-height: 520px;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: left center;
    min-width: 0;
  }

  .body {
    flex: 1 1 520px;
    padding: 110px clamp(24px, 6vw, 96px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }


  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-self: stretch;
  }

  li {
    display: flex;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid rgba(20, 20, 20, 0.18);
  }

  li:last-child {
    border-bottom: 1px solid rgba(20, 20, 20, 0.18);
  }

  .num {
    font-size: 40px;
    color: var(--gold);
    min-width: 56px;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  li p {
    margin-top: 4px;
    color: var(--text-2);
  }

  li a {
    color: var(--gold);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  /* The lock is aligned with the first line («Pago seguro…»), not with the centre of the block */
  .secure {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 18px;
    line-height: 1.6;
    max-width: 360px;
  }

  .secure svg {
    flex: none;
    width: 26px;
    height: 26px;
    /* (line-height 18px × 1.6 = 28.8px − 26px) / 2 */
    margin-top: 1px;
    color: var(--gold);
  }

  .secure strong {
    color: var(--ink);
  }

  @media (max-width: 700px) {
    .photo {
      min-height: 320px;
    }

    .body {
      padding-top: 72px;
      padding-bottom: 72px;
    }
  }
</style>
