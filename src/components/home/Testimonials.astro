---
// Carousel of a single quote. DEMO: example testimonials (visible notice from the design).
import { getTestimonials } from '../../data/testimonials';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const testimonials = getTestimonials(t);
const total = testimonials.length;
---

<!-- DEMO -->
<section class="silver section" aria-labelledby="opiniones-title" data-quotes>
  <div class="container inner">
    <p class="eyebrow" id="opiniones-title">{t('home.testimonials.eyebrow')}</p>
    <svg width="56" height="44" viewBox="0 0 56 44" fill="currentColor" aria-hidden="true" class="mark">
      <path
        d="M0 44V26C0 11 8 2 22 0l2 6c-8 2-12 7-12 14h10v24H0zm32 0V26C32 11 40 2 54 0l2 6c-8 2-12 7-12 14h10v24H32z"
      ></path>
    </svg>
    <div class="stage">
      <div aria-live="polite">
        {
          testimonials.map((q, i) => (
            <blockquote hidden={i !== 0} data-quote>
              <p class="serif quote">{q.text}</p>
              <footer>
                <strong>{q.name}</strong>
                <span>{q.meta}</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
    <div class="qnav">
      <button type="button" class="sq-arrow" aria-label={t('home.testimonials.prev')} data-quote-prev>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6"></path></svg
        >
      </button>
      <div class="dots">
        {
          testimonials.map((_, i) => (
            <button
              type="button"
              class="dot"
              aria-label={t('home.testimonials.dot', { n: i + 1, total })}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-quote-dot={i}
            >
              <span />
            </button>
          ))
        }
      </div>
      <button type="button" class="sq-arrow" aria-label={t('home.testimonials.next')} data-quote-next>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"></path></svg
        >
      </button>
    </div>
    <p class="demo">{t('home.testimonials.demo')}</p>
  </div>
</section>

<style>
  .section {
    padding: 130px 0;
    color: var(--ink);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 36px;
    max-width: 1000px;
  }

  .mark {
    color: var(--accent);
  }

  .stage {
    width: 100%;
  }

  blockquote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  blockquote[hidden] {
    display: none;
  }

  .quote {
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 19px;
  }

  footer strong {
    color: var(--ink);
  }

  footer span {
    color: var(--text-2);
  }

  /* Arrows on both sides of the indicators */
  .qnav {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .dots {
    display: flex;
    gap: 0;
  }

  /* Indicators: 2px bars (16px inactive, 36px active), 44px touch area */
  .dot {
    min-width: 44px;
    height: 44px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .dot span {
    display: block;
    width: 16px;
    height: 2px;
    background: rgba(59, 40, 16, 0.45);
    transition:
      width 0.4s var(--ease),
      background-color 0.4s var(--ease);
  }

  .dot[aria-pressed='true'] span {
    width: 36px;
    background: var(--gold-line);
  }

  .demo {
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .section {
      padding: 88px 0;
    }

    .qnav {
      gap: 8px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-quotes]');
    if (!root) return;
    const quotes = [...root.querySelectorAll<HTMLElement>('[data-quote]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-quote-dot]')];
    let current = 0;
    const show = (i: number) => {
      current = (i + quotes.length) % quotes.length;
      quotes.forEach((q, n) => (q.hidden = n !== current));
      dots.forEach((d, n) => d.setAttribute('aria-pressed', String(n === current)));
    };
    root.querySelector('[data-quote-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-quote-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => show(n)));
  });
</script>
