---
// Carousel of a single quote. DEMO: example testimonials (visible notice from the design).
import { testimonials } from '../../data/testimonials';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const total = testimonials.length;
---

<!-- DEMO -->
<section class="silver section" aria-labelledby="opiniones-title" data-quotes>
  <div class="container inner">
    <p class="eyebrow" id="opiniones-title">{t('home.testimonials.eyebrow')}</p>
    <svg width="56" height="44" viewBox="0 0 56 44" fill="currentColor" aria-hidden="true" class="mark">
      <path
        d="M0 44V26C0 11 8 2 22 0l2 6c-8 2-12 7-12 14h10v24H0zm32 0V26C32 11 40 2 54 0l2 6c-8 2-12 7-12 14h10v24H32z"
      ></path>
    </svg>
    <div class="stage">
      <button type="button" class="qarrow l" aria-label={t('home.testimonials.prev')} data-quote-prev>
        <svg
          width="34"
          height="34"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M20 12H5M11 5l-7 7 7 7"></path></svg
        >
      </button>
      <button type="button" class="qarrow r" aria-label={t('home.testimonials.next')} data-quote-next>
        <svg
          width="34"
          height="34"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7"></path></svg
        >
      </button>
      <div aria-live="polite">
        {
          testimonials.map((q, i) => (
            <blockquote hidden={i !== 0} data-quote>
              <p class="serif quote">{q.text}</p>
              <footer>
                <strong>{q.name}</strong>
                <span>{q.meta}</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
    <div class="dots">
      {
        testimonials.map((_, i) => (
          <button
            type="button"
            class="dot"
            aria-label={t('home.testimonials.dot', { n: i + 1, total })}
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-quote-dot={i}
          >
            <span />
          </button>
        ))
      }
    </div>
    <p class="demo">{t('home.testimonials.demo')}</p>
  </div>
</section>

<style>
  .section {
    padding: 130px 0;
    color: var(--ink);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 36px;
    max-width: 1000px;
  }

  .mark {
    color: var(--accent);
  }

  .stage {
    position: relative;
    width: 100%;
    padding: 0 76px;
  }

  blockquote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  blockquote[hidden] {
    display: none;
  }

  .quote {
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 19px;
  }

  footer strong {
    color: var(--ink);
  }

  footer span {
    color: var(--text-2);
  }

  .qarrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 60px;
    height: 60px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .qarrow:hover {
    transform: translateY(-50%) scale(1.08);
  }

  .qarrow.l {
    left: 0;
  }

  .qarrow.r {
    right: 0;
  }

  .dots {
    display: flex;
    gap: 4px;
  }

  .dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .dot span {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }

  .dot[aria-pressed='true'] span {
    background: var(--ink);
  }

  .demo {
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .section {
      padding: 88px 0;
    }

    .stage {
      padding: 0 0 76px;
    }

    .qarrow {
      top: auto;
      bottom: 0;
      transform: none;
    }

    .qarrow:hover {
      transform: scale(1.08);
    }

    .qarrow.l {
      left: calc(50% - 72px);
    }

    .qarrow.r {
      right: calc(50% - 72px);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-quotes]');
    if (!root) return;
    const quotes = [...root.querySelectorAll<HTMLElement>('[data-quote]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-quote-dot]')];
    let current = 0;
    const show = (i: number) => {
      current = (i + quotes.length) % quotes.length;
      quotes.forEach((q, n) => (q.hidden = n !== current));
      dots.forEach((d, n) => d.setAttribute('aria-pressed', String(n === current)));
    };
    root.querySelector('[data-quote-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-quote-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => show(n)));
  });
</script>
