---
import TwoLineTitle from '../ui/TwoLineTitle.astro';
import Slider from '../ui/Slider.astro';
import ServiceCard from '../ui/ServiceCard.astro';
import { getServices } from '../../data/services';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const services = getServices(t);
---

<section id="servicios" class="bg-base section" aria-labelledby="servicios-title">
  <div class="container head">
    <p class="eyebrow">{t('home.services.eyebrow')}</p>
    <h2 id="servicios-title"><TwoLineTitle text={t('home.services.title')} /></h2>
  </div>
  <Slider prevLabel={t('home.services.prev')} nextLabel={t('home.services.next')} cols={3}>
    {
      services.map((s) => (
        <ServiceCard
          title={s.title}
          text={s.text}
          image={s.image}
          alt={s.alt}
          href={s.href ? localizePath(s.href, lang) : null}
        />
      ))
    }
  </Slider>
</section>

<style>
  .section {
    padding: 130px 0 110px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 52px;
  }

  .head h2 {
    max-width: 720px;
  }

  @media (max-width: 700px) {
    .section {
      padding: 88px 0 72px;
    }

    .head {
      margin-bottom: 36px;
    }
  }
</style>
