---
import Button from '../ui/Button.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Title in two lines: «|» separates the plain line from the italic one.
const [titleLine1, titleLine2 = ''] = t('home.hero.title').split('|');

// Letter-by-letter entrance: one span per letter (growing delay of 0.045s from 0.35s),
// grouped in one nowrap span per word so words never break.
let letterIndex = 0;
const toWords = (line: string) =>
  line.split(' ').map((word) =>
    [...word].map((char) => ({ char, delay: (0.35 + letterIndex++ * 0.045).toFixed(3) })),
  );
const titleWords1 = toWords(titleLine1);
const titleWords2 = toWords(titleLine2);
---

<section class="hero" aria-label={t('home.hero.label')}>
  <!-- All attributes are required for autoplay on iOS Safari (CAMBIOS-v5 §4) -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    webkit-playsinline
    preload="auto"
    disablepictureinpicture
    disableremoteplayback
    poster="/video/hero-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/video/hero-720.mp4" type="video/mp4" media="(max-width: 900px)" />
    <source src="/video/hero.mp4" type="video/mp4" />
  </video>
  <div class="veil" aria-hidden="true"></div>
  <div class="container content">
    <p class="eyebrow"><span>{t('home.hero.eyebrow')}</span></p>
    <h1 aria-label={`${titleLine1} ${titleLine2}`}>
      <span aria-hidden="true">
        {titleWords1.map((word, i) => (
          <>
            {i > 0 && ' '}
            <span class="word">
              {word.map((l) => <span class="wave" style={`animation-delay:${l.delay}s`}>{l.char}</span>)}
            </span>
          </>
        ))}
      </span>
      <br />
      <em aria-hidden="true">
        {titleWords2.map((word, i) => (
          <>
            {i > 0 && ' '}
            <span class="word">
              {word.map((l) => <span class="wave" style={`animation-delay:${l.delay}s`}>{l.char}</span>)}
            </span>
          </>
        ))}
      </em>
    </h1>
    <p class="text">{t('home.hero.text')}</p>
    <div class="ctas">
      <Button href={localizePath('/reserva', lang)} variant="v5-dark">{t('home.hero.ctaBook')}</Button>
      <Button href="#servicios" variant="v5-light">{t('home.hero.ctaServices')}</Button>
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true">
    <span class="cue-line"></span>
    <span class="cue-text">{t('home.hero.scroll')}</span>
  </div>
</section>

<style>
  /* Fallback: if the video cannot start, the poster is seen as a still image. */
  /* min-height (not height): the hero grows when the content does not fit
     (small phones, browser text size at 130 %) instead of spilling under the header. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    min-height: max(640px, 100vh);
    min-height: max(640px, 100svh);
    overflow: hidden;
    background: #e9efec url('/video/hero-poster.jpg') center / cover no-repeat;
  }

  /* Large screens: same 940px cap as before, but as a minimum so it can still grow */
  @media (min-width: 1024px) {
    .hero {
      min-height: clamp(640px, 100vh, 940px);
      min-height: clamp(640px, 100svh, 940px);
    }
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Never show the native iOS play button (Low Power Mode blocks autoplay) */
  .hero-video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  .hero-video::-webkit-media-controls {
    display: none !important;
  }

  .hero.no-video .hero-video {
    display: none;
  }

  /* Very soft white-to-turquoise veil + white halo behind the text (does not darken) */
  .veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 58% 52% at 50% 54%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 75%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.16) 0%, rgba(178, 226, 232, 0.16) 100%);
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* clear the fixed header */
    padding-top: calc(var(--header-h) + 24px);
    /* room for the scroll cue (30 + 56 + 12 + 11 = 109px), so it never overlaps the buttons */
    padding-bottom: 140px;
  }

  /* Eyebrow with a gold line on each side (flex: the lines stay centred when the text wraps) */
  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 15px;
    color: var(--hero-eyebrow);
  }

  .eyebrow::before,
  .eyebrow::after {
    content: '';
    flex: none;
    width: 44px;
    height: 1px;
    margin: 0;
    background: var(--gold-line);
  }

  h1 {
    margin-top: 34px;
    color: var(--hero-ink);
    text-shadow: 0 1px 18px rgba(255, 255, 255, 0.55);
  }

  h1 em {
    color: var(--hero-accent);
  }

  .text {
    margin-top: 30px;
    max-width: 640px;
    font-size: 21px;
    line-height: 1.7;
    color: var(--hero-ink);
    text-shadow: 0 1px 12px rgba(255, 255, 255, 0.7);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 42px;
  }

  /* Scroll cue (decorative) */
  .scroll-cue {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .cue-line {
    display: block;
    width: 1px;
    height: 56px;
    background: rgba(59, 40, 16, 0.55);
  }

  .cue-text {
    font: 700 11px/1 var(--font-sans);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--brown);
  }

  @media (max-width: 700px) {
    .eyebrow {
      gap: 10px;
      letter-spacing: 0.2em;
    }

    .eyebrow::before,
    .eyebrow::after {
      width: 24px;
    }

    h1 {
      font-size: clamp(44px, 12vw, 64px);
    }

    .text {
      font-size: 19px;
    }

    .ctas {
      flex-direction: column;
      align-self: stretch;
    }

    .ctas :global(.btn-v5) {
      width: 100%;
      padding: 0 20px;
    }
  }

  /* Small or short screens: tighter spacing so everything fits below the header */
  @media (max-width: 479.98px), (max-height: 699.98px) {
    h1 {
      margin-top: 20px;
      font-size: clamp(40px, 11vw, 56px);
    }

    .text {
      font-size: 18px;
    }

    .ctas {
      margin-top: 28px;
    }
  }

  /* ── Entrance on load (not on scroll) ── */
  .hero-video {
    animation: hero-video-in 1.6s var(--ease) both;
  }

  .eyebrow {
    animation: hero-drop 0.8s var(--ease) 0.1s both;
  }

  .word {
    display: inline-block;
    white-space: nowrap;
  }

  .wave {
    display: inline-block;
    animation: hero-wave 0.9s var(--ease) both;
  }

  .text {
    animation: hero-rise 0.9s var(--ease) 1.15s both;
  }

  .ctas {
    animation: hero-rise 0.9s var(--ease) 1.35s both;
  }

  .scroll-cue {
    animation: hero-fade 0.8s var(--ease) 1.9s both;
  }

  /* The line «drips»: grows from the top, then shrinks towards the bottom */
  .cue-line {
    animation: hero-drip 2.4s var(--ease) 1.9s infinite;
  }

  @keyframes hero-video-in {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-drop {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-wave {
    from {
      opacity: 0;
      transform: translateY(0.55em) rotate(4deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-drip {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    50.01% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* Everything still and visible from the start */
  @media (prefers-reduced-motion: reduce) {
    .hero-video,
    .eyebrow,
    .wave,
    .text,
    .ctas,
    .scroll-cue,
    .cue-line {
      animation: none !important;
    }
  }

  /* Short screens (landscape phones): the scroll cue would overlap the buttons */
  @media (max-height: 720px) {
    .scroll-cue {
      display: none;
    }

    .content {
      padding-bottom: 48px;
    }
  }
</style>

<script>
  // With ClientRouter, autoplay does not fire by itself when coming back to the home page.
  document.addEventListener('astro:page-load', () => {
    const v = document.querySelector<HTMLVideoElement>('.hero-video');
    if (v) {
      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      const p = v.play();
      if (p && p.catch) p.catch(() => v.closest('.hero')?.classList.add('no-video'));
    }
  });
</script>
