---
import TwoLineTitle from '../ui/TwoLineTitle.astro';
import Slider from '../ui/Slider.astro';
import ExtraCard from '../ui/ExtraCard.astro';
import Button from '../ui/Button.astro';
import { getExtras, HOME_EXTRAS_COUNT } from '../../data/extras';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeExtras = getExtras(t).slice(0, HOME_EXTRAS_COUNT);
---

<section id="extras" class="bg-white section" aria-labelledby="extras-title">
  <Slider prevLabel={t('home.extras.prev')} nextLabel={t('home.extras.next')} cols={4}>
    <div slot="head" class="head" data-reveal="left">
      <p class="eyebrow">{t('home.extras.eyebrow')}</p>
      <h2 id="extras-title"><TwoLineTitle text={t('home.extras.title')} /></h2>
      <p class="lead">{t('home.extras.text')}</p>
    </div>
    {homeExtras.map((extra, i) => <ExtraCard extra={extra} index={i} />)}
  </Slider>
  <div class="container more">
    <Button href={localizePath('/extras', lang)}>{t('home.extras.cta')}</Button>
  </div>
</section>

<style>
  .section {
    padding: 130px 0 110px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
  }

  .head .lead {
    font-size: 19px;
  }

  .more {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 700px) {
    .section {
      padding: 88px 0 72px;
    }

    .head {
      margin-bottom: 36px;
    }
  }
</style>
