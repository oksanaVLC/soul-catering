---
import TwoLineTitle from '../ui/TwoLineTitle.astro';
import BlogCard from '../ui/BlogCard.astro';
import Button from '../ui/Button.astro';
import { getHomePosts } from '../../data/blog';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homePosts = getHomePosts(t);
---

<section class="bg-white section" aria-labelledby="blog-title">
  <div class="container inner">
    <div class="head">
      <div class="titles" data-reveal="left">
        <p class="eyebrow">{t('home.blog.eyebrow')}</p>
        <h2 id="blog-title"><TwoLineTitle text={t('home.blog.title')} /></h2>
      </div>
      <Button href={localizePath('/blog', lang)} variant="light" data-reveal="right" data-reveal-delay="1">{t('home.blog.cta')}</Button>
    </div>
    <div class="grid">
      {homePosts.map((post, i) => <BlogCard post={post} variant="teaser" revealDelay={i % 3} />)}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 130px 0;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }


  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 40px;
  }

  @media (max-width: 700px) {
    .section {
      padding: 88px 0;
    }

    .inner {
      gap: 40px;
    }
  }
</style>
