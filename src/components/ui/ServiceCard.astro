---
// Service card: radius 20px, square image, white body, text link «Descubrir →».
// Without href (page not designed yet), «Descubrir» shows as pending text, not as a link.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
  href: string | null;
}

const { title, text, image, alt, href } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<li class="scard">
  <div class="scard-img">
    <Image
      src={image}
      alt={alt}
      widths={[400, 600, 800]}
      sizes="(max-width: 700px) 84vw, (max-width: 1100px) 50vw, 420px"
      loading="lazy"
    />
  </div>
  <div class="scard-body">
    <h3>{title}</h3>
    <p>{text}</p>
    {
      href ? (
        <a class="scard-link" href={href} aria-label={t('common.discoverLabel', { title })}>
          {t('common.discover')}
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 12h15M13 5l7 7-7 7" />
          </svg>
        </a>
      ) : (
        <a class="scard-link is-pending">
          {t('common.discover')}
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 12h15M13 5l7 7-7 7" />
          </svg>
          <span class="sr-only">{t('a11y.pending')}</span>
        </a>
      )
    }
  </div>
</li>

<style>
  /* Width and position: set by the Slider (grid or carousel) */
  .scard {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(58, 36, 24, 0.08);
    border: 1px solid var(--line-card);
  }

  .scard-img {
    overflow: hidden;
  }

  .scard-img :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: saturate(0.85);
    transition: transform 0.7s ease;
  }

  .scard:hover .scard-img :global(img) {
    transform: scale(1.04);
  }

  .scard-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 28px 24px;
    flex: 1;
  }

  h3 {
    font-size: 32px;
  }

  /* «Descubrir» goes right after the text (no stretching gap) */
  p {
    color: var(--text-2);
    font-size: 18px;
  }

  .scard-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
    align-self: flex-start;
  }

  .scard-link svg {
    transition: transform 0.25s ease;
  }

  .scard-link[href]:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .scard-link[href]:hover svg {
    transform: translateX(5px);
  }

</style>
