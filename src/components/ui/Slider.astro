---
// Card gallery. Large screens: every card visible in a grid (no carousel).
// Smaller screens: horizontal swipe carousel (CSS scroll-snap, no libraries). The section
// header goes in the "head" slot; the square arrows (<button> with aria-label) sit on its
// right (below it on mobile) and small dots BELOW the cards show which card is in view.
interface Props {
  prevLabel: string;
  nextLabel: string;
  /** Columns of the grid on large screens. Incomplete last rows are centred. */
  cols?: 3 | 4;
  /** Width from which the grid replaces the carousel: lg = 1024px, xl = 1280px. */
  gridFrom?: 'lg' | 'xl';
  /** Wider than the text container (up to 1400px), for 4 columns of rich cards. */
  wide?: boolean;
}

const { prevLabel, nextLabel, cols = 3, gridFrom = 'lg', wide = false } = Astro.props;
---

<div class:list={['slider', `grid-${gridFrom}`, { wide }]} style={`--cols:${cols}`} data-slider>
  <!-- Section header (slot "head") with the arrows on the right, aligned to the bottom of the title -->
  <div class="container slider-head">
    <div class="head-text"><slot name="head" /></div>
    <div class="arrows">
      <button type="button" class="sq-arrow" aria-label={prevLabel} data-slider-prev>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6"></path></svg
        >
      </button>
      <button type="button" class="sq-arrow" aria-label={nextLabel} data-slider-next>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"></path></svg
        >
      </button>
    </div>
  </div>
  <ul class="track" data-slider-track>
    <slot />
  </ul>
  <!-- Visual indicator only: the arrows and swiping are the controls -->
  <div class="dots" aria-hidden="true" data-slider-dots></div>
</div>

<style>
  .slider {
    --gap: 28px;
    max-width: var(--container);
    margin: 0 auto;
  }

  .wide {
    max-width: 1400px;
  }

  /* ── Carousel (default) ── */
  .track {
    /* positioned: so absolute children (.sr-only) stay clipped inside the track */
    position: relative;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    list-style: none;
    margin: 0;
    padding: 4px var(--gutter) 24px;
    scroll-padding-inline: var(--gutter);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track > :global(li) {
    flex: 0 0 calc((100% - var(--gap)) / 2);
    min-width: 0;
    scroll-snap-align: start;
  }

  .slider-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 52px;
  }

  .head-text {
    min-width: 0;
  }

  .arrows {
    display: flex;
    gap: 12px;
    flex: none;
  }

  .dots {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    min-height: 24px;
    padding: 4px var(--gutter) 0;
  }

  /* Inactive: small round dot. Active: longer dark pill (shape, not just colour). */
  .dots :global(span) {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--field-border-a11y);
    transition:
      width 0.25s ease,
      background-color 0.25s ease;
  }

  .dots :global(span.on) {
    width: 24px;
    background: var(--ink);
  }

  @media (max-width: 700px) {
    .track > :global(li) {
      flex-basis: 84%;
    }

    /* Mobile: arrows below the title */
    .slider-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      margin-bottom: 36px;
    }
  }

  /* ── Grid: all the cards visible, no carousel ── */
  @media (min-width: 1024px) {
    .grid-lg .track {
      flex-wrap: wrap;
      justify-content: center;
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
      row-gap: 40px;
    }

    .grid-lg .track > :global(li) {
      flex-basis: calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    }

    .grid-lg .arrows,
    .grid-lg .dots {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    .grid-xl .track {
      flex-wrap: wrap;
      justify-content: center;
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
      row-gap: 40px;
    }

    .grid-xl .track > :global(li) {
      flex-basis: calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    }

    .grid-xl .arrows,
    .grid-xl .dots {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
      const track = slider.querySelector<HTMLElement>('[data-slider-track]');
      const dotsBox = slider.querySelector<HTMLElement>('[data-slider-dots]');
      const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
      const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
      if (!track || !dotsBox || !prev || !next) return;
      const items = Array.from(track.children) as HTMLElement[];
      if (!items.length) return;

      dotsBox.replaceChildren(...items.map(() => document.createElement('span')));
      const dots = Array.from(dotsBox.children);

      // Distance between the start of two consecutive cards
      const step = () => (items[1] ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth);

      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        const atEnd = track.scrollLeft >= max - 2;
        const index = atEnd ? items.length - 1 : Math.round(track.scrollLeft / step());
        dots.forEach((dot, i) => dot.classList.toggle('on', i === index));
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = atEnd;
      };

      let frame = 0;
      track.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(update);
        },
        { passive: true },
      );
      new ResizeObserver(update).observe(track);
      prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
      next.addEventListener('click', () => track.scrollBy({ left: step() }));
      update();
    });
  });
</script>
