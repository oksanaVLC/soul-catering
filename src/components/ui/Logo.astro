---
// One-line logo «Soul Catering» in Casko Luxury, the same on every page.
// tone="light": light color for dark backgrounds (footer).
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

interface Props {
  tone?: 'dark' | 'light';
  /** false: plain text (no link), e.g. inside the panel sidebar. */
  link?: boolean;
  class?: string;
}

const { tone = 'dark', link = true, class: extra } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const Tag = link ? 'a' : 'span';
---

<Tag
  href={link ? localizePath('/', lang) : undefined}
  class:list={['logo', `tone-${tone}`, extra]}
  aria-label={link ? t('nav.home') : undefined}
>
  <span aria-hidden={link ? 'true' : undefined}>Soul Catering</span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 400 29px/1.05 var(--font-logo);
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--bronze);
    text-decoration: none;
  }

  .tone-light {
    color: var(--foot-logo);
  }
</style>
