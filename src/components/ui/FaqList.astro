---
// Accordion of questions with native <details>. The first one opens as in the design.
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item, i) => (
      <details class="faq" open={i === 0}>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--line-strong);
  }
</style>
