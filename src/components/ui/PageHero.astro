---
// Inner page header: full-width photo that blends into --bg at the bottom with a gradient.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  /** Empty when the photo is decorative (as in the design for Extras and Blog). */
  alt?: string;
  /** object-position of the photo (design: center 30–45 %). */
  position?: string;
  /** Top padding at desktop, where the photo shows (design: 360–420px). */
  padTop?: number;
  padBottom?: number;
  /** Gradient opacity at 58 % (design: .75 or .78). */
  fade?: number;
}

const { image, alt = '', position = 'center 40%', padTop = 380, padBottom = 72, fade = 0.78 } =
  Astro.props;
---

<section
  class="page-hero"
  style={`--pad-top:${padTop}px;--pad-bottom:${padBottom}px;--fade:rgba(246,242,233,${fade})`}
>
  <Image
    src={image}
    alt={alt}
    aria-hidden={alt ? undefined : 'true'}
    widths={[800, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    style={`object-position:${position}`}
  />
  <div class="fade" aria-hidden="true"></div>
  <div class="container content">
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    padding: var(--pad-top) 0 var(--pad-bottom);
  }

  .page-hero > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(246, 242, 233, 0) 0%,
      rgba(246, 242, 233, 0) 30%,
      var(--fade) 58%,
      var(--bg) 82%
    );
  }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Mobile: the text is much taller than on desktop. The photo only covers the top part
     and the text starts in the area already faded by the gradient, so it stays readable. */
  @media (max-width: 900px) {
    .page-hero {
      padding-top: calc(var(--pad-top) * 0.6);
    }

    .page-hero > :global(img),
    .fade {
      bottom: auto;
      height: calc(var(--pad-top) * 0.6 + 140px);
    }

    .fade {
      background: linear-gradient(
        180deg,
        rgba(246, 242, 233, 0) 0%,
        rgba(246, 242, 233, 0) 35%,
        var(--fade) 68%,
        var(--bg) 100%
      );
    }
  }
</style>
