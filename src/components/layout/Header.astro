---
import { getLangFromUrl, localizePath, switchLangPath, useTranslations } from '../../i18n/utils';

import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import MobileMenu, { type NavItem } from './MobileMenu.astro';

interface Props {
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizePath('/', lang);

/*
 * Pathname without language prefix.
 * Used to determine the active section.
 */
const path = switchLangPath(Astro.url.pathname, 'es');

const isIn = (base: string) => path === base || path.startsWith(`${base}/`);

const items: NavItem[] = [
  {
    href: `${home}#servicios`,
    label: t('nav.services'),
    current: isIn('/servicios'),
  },
  {
    href: `${home}#sobre-nosotros`,
    label: t('nav.about'),
    current: false,
  },
  {
    href: localizePath('/extras', lang),
    label: t('nav.extras'),
    current: isIn('/extras'),
  },
  {
    href: localizePath('/blog', lang),
    label: t('nav.blog'),
    current: isIn('/blog'),
  },
  {
    href: `${home}#contacto`,
    label: t('nav.contact'),
    current: false,
  },
];

const bookHref = localizePath('/reserva', lang);
const loginHref = localizePath('/acceso', lang);
---

<header class="site-header" data-site-header>
  <div class="container bar">
    <Logo />

    <nav class="nav-desktop" aria-label={t('nav.label')}>
      {items.map((item) => (
        <a class="navlink" href={item.href} aria-current={item.current ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="tools">
      <LangSwitcher />

      <Button href={bookHref} variant="v5-dark" size="sm" class="nav-desktop">
        {t('nav.book')}
      </Button>

      <Button href={loginHref} variant="v5-dark" size="sm" class="nav-desktop">
        {t('nav.login')}
      </Button>

      <!-- Button stays inside the header -->
      <MobileMenu items={items} bookHref={bookHref} loginHref={loginHref} />
    </div>
  </div>
</header>

<!--
  IMPORTANT:
  MobileMenu.astro renders the panel as a sibling of <header>,
  not as a child of it.
-->
<style>
  /* Fixed and translucent on every public page (CAMBIOS-v5 §2).
     .is-solid (after 40px of scroll) makes the background almost opaque. */
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(138, 104, 48, 0.12);
    transition: background-color 0.5s var(--ease);
  }

  .site-header.is-solid {
    background: rgba(255, 255, 255, 0.97);
  }

  /* Wider than --container so the one-line logo + menu fit on one line */
  .bar {
    max-width: 1380px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 100%;
    flex-wrap: nowrap;
  }

  nav {
    display: flex;
    gap: 30px;
    align-items: center;
    flex-wrap: nowrap;
  }

  .navlink {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-v5);
    text-decoration: none;
    font: 400 15px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* 1px line in --gold-line that grows on hover (and marks the current page) */
  .navlink::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.2em; /* compensates the trailing letter-spacing */
    bottom: 8px;
    height: 1px;
    background: var(--gold-line);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }

  .navlink:hover {
    color: var(--ink-v5);
  }

  .navlink:hover::after,
  .navlink[aria-current]::after {
    transform: scaleX(1);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  /* Narrow desktops: less space between links so everything stays on one line */
  @media (max-width: 1400px) {
    nav {
      gap: 22px;
    }
  }

  @media (max-width: 1259px) {
    .nav-desktop,
    .tools :global(.nav-desktop) {
      display: none;
    }
  }

  /* Phones: the one-line logo scales down (29px from 468px up) so the language
     switcher and the menu button still fit next to it */
  @media (max-width: 480px) {
    .bar {
      gap: 12px;
    }

    .bar > :global(.logo) {
      font-size: clamp(22px, 6.2vw, 29px);
    }

    .tools {
      gap: 0;
    }
  }

  @media (max-width: 360px) {
    .bar {
      gap: 8px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .tools {
      gap: 0;
    }
  }
</style>

<script>
  // .is-solid after 40px of scroll. Passive listener, re-bound after each navigation.
  let onScroll: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (onScroll) window.removeEventListener('scroll', onScroll);
    if (!header) return;
    onScroll = () => header.classList.toggle('is-solid', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>
