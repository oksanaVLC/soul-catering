---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faXmark } from '@fortawesome/free-solid-svg-icons';
import Button from '../ui/Button.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { faInstagram, faLinkedinIn, faYoutube } from '@fortawesome/free-brands-svg-icons';

export type NavItem = {
  href: string;
  label: string;
  current: boolean;
};

interface Props {
  items: NavItem[];
  bookHref: string;
  loginHref: string;
}

const { items, bookHref, loginHref } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const close = icon(faXmark, {
  classes: ['icon-close'],
  attributes: {
    'aria-hidden': 'true',
  },
}).html.join('');
---

<button
  class="menu-btn"
  type="button"
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-label={t('nav.menuOpen')}
  data-menu-btn
  data-label-open={t('nav.menuOpen')}
  data-label-close={t('nav.menuClose')}
>
  <svg
    class="icon-open"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>

  <Fragment set:html={close} />
</button>

<div id="mobile-menu" class="mobile-panel bg-white" hidden data-menu-panel>
  <nav class="container mobile-nav" aria-label={t('nav.mobileLabel')}>
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="actions">
      <Button href={bookHref} variant="v5-dark">{t('nav.book')}</Button>
      <Button href={loginHref} variant="v5-dark">{t('nav.login')}</Button>
    </div>
    <div class="socials" aria-label="Social media">
      <a href="#" aria-label="YouTube" class="social-link">
        <Fragment
          set:html={icon(faYoutube, {
            attributes: { 'aria-hidden': 'true' },
          }).html.join('')}
        />
      </a>

      <a href="#" aria-label="LinkedIn" class="social-link">
        <Fragment
          set:html={icon(faLinkedinIn, {
            attributes: { 'aria-hidden': 'true' },
          }).html.join('')}
        />
      </a>

      <a href="#" aria-label="Instagram" class="social-link">
        <Fragment
          set:html={icon(faInstagram, {
            attributes: { 'aria-hidden': 'true' },
          }).html.join('')}
        />
      </a>
    </div>
  </nav>
</div>

<style>
  .menu-btn {
    display: none;
    position: relative;
    z-index: 2002;

    width: 52px;
    height: 52px;
    padding: 0;

    border: 0;
    border-radius: 50%;

    background: transparent;
    color: var(--ink-v5);

    align-items: center;
    justify-content: center;

    cursor: pointer;
    flex: none;
  }

  .menu-btn:hover {
    background: rgba(20, 20, 20, 0.08);
  }

  .icon-open {
    display: block;
  }

  .menu-btn :global(.icon-close) {
    display: none;
    font-size: 24px;
  }

  .menu-btn[aria-expanded='true'] .icon-open {
    display: none;
  }

  .menu-btn[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  /*
       * The panel is a sibling of <header>.
       * It therefore cannot cover the header/logo/language switcher.
       */
  .mobile-panel {
    position: fixed;
    z-index: 49; /* just below the fixed header (z-index 50) */

    top: var(--header-h);
    right: 0;
    bottom: 0;
    left: 0;

    width: 100%;
    min-height: calc(100dvh - var(--header-h));

    padding: 20px 0 32px;

    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-panel[hidden] {
    display: none !important;
  }

  .mobile-nav {
    width: 100%;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav li + li {
    border-top: 1px solid var(--line-header);
  }

  .mobile-nav > ul a {
    display: flex;
    align-items: center;

    min-height: 60px;

    color: var(--ink);
    text-decoration: none;

    font-size: 22px;
    font-weight: 600;
  }

  .mobile-nav > ul a:hover,
  .mobile-nav > ul a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 20px;
  }

  @media (max-width: 1180px) {
    .menu-btn {
      display: inline-flex;
    }
  }

  @media (min-width: 1181px) {
    .menu-btn,
    .mobile-panel {
      display: none !important;
    }
  }
  .socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 56px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    border-radius: 50%;

    background: var(--ink);
    color: var(--white);

    text-decoration: none;

    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .social-link:hover {
    background: var(--ink-hover);
    color: var(--white);
    transform: translateY(-1px);
  }

  .social-link :global(.svg-inline--fa) {
    width: 20px;
    height: 20px;
    color: currentColor;
  }

  @media (min-width: 1181px) {
    .socials {
      display: none;
    }
  }
</style>

<script>
  function getParts() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');

    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

    return btn && panel ? { btn, panel } : null;
  }

  function setOpen(btn: HTMLButtonElement, panel: HTMLElement, open: boolean, returnFocus = false) {
    btn.setAttribute('aria-expanded', String(open));

    btn.setAttribute(
      'aria-label',
      open ? (btn.dataset.labelClose ?? '') : (btn.dataset.labelOpen ?? ''),
    );

    panel.hidden = !open;

    document.documentElement.classList.toggle('mobile-menu-open', open);

    /*
     * Lock both html and body.
     */
    document.documentElement.style.overflow = open ? 'hidden' : '';
    document.body.style.overflow = open ? 'hidden' : '';

    if (!open && returnFocus) {
      btn.focus();
    }
  }

  function closeMenu(returnFocus = false) {
    const parts = getParts();

    if (!parts) return;

    setOpen(parts.btn, parts.panel, false, returnFocus);
  }

  /*
   * Open / close button and menu-link handling.
   */
  document.addEventListener('astro:page-load', () => {
    const parts = getParts();

    if (!parts) return;

    const { btn, panel } = parts;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      setOpen(btn, panel, !isOpen);
    });

    panel.addEventListener('click', (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      const link = target.closest('a');

      if (link) {
        setOpen(btn, panel, false);
      }
    });
  });

  /*
   * Escape closes the menu.
   */
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    const parts = getParts();

    if (!parts) return;

    const isOpen = parts.btn.getAttribute('aria-expanded') === 'true';

    if (isOpen) {
      closeMenu(true);
    }
  });

  /*
   * If the viewport becomes desktop width,
   * always close the mobile menu.
   */
  const desktopMedia = window.matchMedia('(min-width: 1181px)');

  desktopMedia.addEventListener('change', (event) => {
    if (event.matches) {
      closeMenu();
    }
  });
</script>
