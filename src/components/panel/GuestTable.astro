---
// Guest list (design 06) with filters and name search. The logic is in
// src/lib/panel/guests.ts; here it is only painted. DEMO data: nothing is saved, reloading resets it.
// The design's action buttons (edit, reminder, allergy form) have no behavior
// defined: they keep their appearance but are marked as not available (aria-disabled).
import type { Guest } from '../../types/guest';
import StatusBadge from './StatusBadge.astro';
import { countGuests, GUEST_FILTERS } from '../../lib/panel/guests';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  guests: Guest[];
}

const { guests } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const counts = countGuests(guests);
const showingTpl = t('panel.showing');
---

<section class="card list" aria-label={t('panel.listLabel')} data-guests data-showing={showingTpl}>
  <div class="tools">
    <div role="group" aria-label={t('panel.filterLabel')} class="filters">
      {
        GUEST_FILTERS.map((filter, i) => (
          <button type="button" class="chip pchip" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={filter}>
            {t(`panel.filter.${filter}`)}
          </button>
        ))
      }
    </div>
    <div class="search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
      </svg>
      <label for="buscar" class="sr-only">{t('panel.searchLabel')}</label>
      <input id="buscar" class="input sinput" type="search" placeholder={t('panel.searchPlaceholder')} data-search />
    </div>
  </div>

  <div class="table-wrap" role="region" aria-label={t('panel.listLabel')} tabindex="0">
    <table>
      <thead>
        <tr>
          <th scope="col" class="first">{t('panel.colGuest')}</th>
          <th scope="col">{t('panel.colTable')}</th>
          <th scope="col">{t('panel.colAttendance')}</th>
          <th scope="col">{t('panel.colMenu')}</th>
          <th scope="col">{t('panel.colAllergies')}</th>
          <th scope="col" class="last">{t('panel.colActions')}</th>
        </tr>
      </thead>
      <tbody>
        {
          guests.map((g) => (
            <tr data-guest={g.id}>
              <td class="first">
                <div class="who">
                  <strong>{g.name}</strong>
                  <span>{g.email ?? t('panel.none')}</span>
                </div>
              </td>
              <td>{g.table}</td>
              <td>
                <StatusBadge status={g.attendance} />
              </td>
              <td>{g.menu ? t(`guestMenu.${g.menu}`) : t('panel.none')}</td>
              <td>
                <div class="als">
                  {g.allergens.length ? (
                    g.allergens.map((a) => <span class="al">{t(`guestAllergen.${a}`)}</span>)
                  ) : (
                    <span class="none">{t('panel.none')}</span>
                  )}
                </div>
              </td>
              <td class="last actions">
                <button type="button" class="iconbtn" aria-disabled="true" aria-label={`${t('panel.edit')}: ${g.name} ${t('a11y.pending')}`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 20h4L19 9l-4-4L4 16v4z" />
                  </svg>
                </button>
                <button type="button" class="iconbtn" aria-disabled="true" aria-label={`${t('panel.remind')}: ${g.name} ${t('a11y.pending')}`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M3 7l9 6 9-6" />
                  </svg>
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="empty" hidden data-empty>{t('panel.empty')}</p>

  <div class="foot-row">
    <span aria-live="polite" data-showing-text>{showingTpl.replace('{shown}', String(counts.total)).replace('{total}', String(counts.total))}</span>
    <button type="button" class="pbtn ghost" aria-disabled="true">
      {t('panel.sendForm')}<span class="sr-only"> {t('a11y.pending')}</span>
    </button>
  </div>
</section>

<style>
  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .list {
    padding: 24px 0 8px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pchip {
    min-height: 48px;
    padding: 0 18px;
    border-color: var(--line-chip);
    font-size: 16px;
  }

  .pchip[aria-pressed='true'] {
    border-color: var(--ink);
  }

  .search {
    position: relative;
    flex: 0 1 320px;
    min-width: 220px;
  }

  .search svg {
    position: absolute;
    left: 18px;
    top: 16px;
    color: var(--muted);
  }

  .sinput {
    min-height: 52px;
    border-radius: 999px;
    padding: 0 18px 0 48px;
    font-size: 18px;
  }

  .table-wrap {
    position: relative;
    overflow-x: auto;
  }

  .table-wrap:focus-visible {
    outline-offset: -3px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
  }

  /* Design: 14px; 15px (CLAUDE.md minimum for real text) */
  th {
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    font-weight: 700;
    padding: 16px 14px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  td {
    padding: 16px 14px;
    border-bottom: 1px solid var(--line-panel);
    vertical-align: middle;
    font-size: 17px;
  }

  tr:hover td {
    background: var(--table-hover);
  }

  .first {
    padding-left: 24px;
  }

  .last {
    text-align: right;
    padding-right: 24px;
  }

  .actions {
    white-space: nowrap;
  }

  .who {
    display: flex;
    flex-direction: column;
  }

  .who strong {
    color: var(--ink);
    font-weight: 600;
  }

  .who span {
    font-size: 15px;
    color: var(--muted);
  }

  .als {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Design: 14px; 15px (CLAUDE.md minimum) */
  .al {
    display: inline-flex;
    font-size: 15px;
    font-weight: 600;
    color: var(--allergen);
    background: var(--allergen-bg);
    border-radius: 999px;
    padding: 3px 11px;
    white-space: nowrap;
  }

  .none {
    color: var(--muted);
    font-size: 16px;
  }

  .iconbtn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: var(--white);
    color: var(--ink);
    cursor: not-allowed;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .empty {
    padding: 24px;
    text-align: center;
    color: var(--muted);
  }

  .foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 8px 24px 16px;
    font-size: 16px;
    color: var(--muted);
  }

  .pbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font: 600 17px var(--font-sans);
    border: 1.5px solid transparent;
    white-space: normal;
    text-align: center;
  }

  .ghost {
    border-color: var(--field-border-a11y);
    background: var(--white);
    color: var(--ink);
  }

  .pbtn[aria-disabled='true'] {
    cursor: not-allowed;
  }

  @media (max-width: 700px) {
    .tools,
    .foot-row {
      padding-left: 16px;
      padding-right: 16px;
    }

    .search {
      flex: 1 1 100%;
      min-width: 0;
    }
  }
</style>

<script>
  // Filters and search: shared logic (filterGuests) on the DEMO data.
  import { filterGuests } from '../../lib/panel/guests';
  import { demoGuests } from '../../data/guests';
  import type { GuestFilter } from '../../types/guest';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-guests]');
    if (!root) return;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const search = root.querySelector<HTMLInputElement>('[data-search]');
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('[data-guest]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const showing = root.querySelector<HTMLElement>('[data-showing-text]');
    let filter: GuestFilter = 'all';

    const render = () => {
      const visible = new Set(filterGuests(demoGuests, filter, search?.value ?? '').map((g) => g.id));
      rows.forEach((row) => (row.hidden = !visible.has(row.dataset.guest ?? '')));
      if (empty) empty.hidden = visible.size > 0;
      if (showing) {
        showing.textContent = (root.dataset.showing ?? '')
          .replace('{shown}', String(visible.size))
          .replace('{total}', String(demoGuests.length));
      }
    };
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        filter = chip.dataset.filter as GuestFilter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        render();
      }),
    );
    search?.addEventListener('input', render);
    render();
  });
</script>
