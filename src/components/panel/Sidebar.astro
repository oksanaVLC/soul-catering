---
// Panel side menu (design 06). Only «Invitados» has an approved page; the other entries
// keep the design's appearance but are NOT functional (no href, «pendiente» for screen readers)
// until there is an approved specification. No fictitious pages are created.
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

type Item = { key: string; href: string | null; icon: string };

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname.replace(/\/$/, '');

// Icons copied from the design (24×24, stroke).
const items: Item[] = [
  { key: 'panel.navSummary', href: null, icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>' },
  { key: 'panel.navBookings', href: null, icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
  { key: 'panel.navGuests', href: localizePath('/panel/invitados', lang), icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.4 0 4 1.5 4.6 4"/>' },
  { key: 'panel.navMenus', href: null, icon: '<path d="M6 3v8a3 3 0 0 0 6 0V3M9 3v18M17 3c-1.7 1-2.5 3-2.5 6s1 4 2.5 4v8"/>' },
  { key: 'panel.navPayments', href: null, icon: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19"/>' },
  { key: 'panel.navStats', href: null, icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>' },
  { key: 'panel.navSettings', href: null, icon: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>' },
];
---

<aside class="side" aria-label={t('panel.navLabel')}>
  <a href={localizePath('/', lang)} class="brand" aria-label={t('nav.home')}>
    <span class="logo-font brand-name">{t('site.name')}</span>
    <span class="brand-sub">{t('panel.brandSub')}</span>
  </a>
  <nav aria-label={t('panel.navLabel')}>
    <ul>
      {
        items.map((item) => (
          <li>
            {item.href ? (
              <a href={item.href} aria-current={item.href.replace(/\/$/, '') === current ? 'page' : undefined}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" set:html={item.icon} />
                {t(item.key as Parameters<typeof t>[0])}
              </a>
            ) : (
              <a class="is-pending">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" set:html={item.icon} />
                {t(item.key as Parameters<typeof t>[0])}
                <span class="sr-only"> {t('a11y.pending')}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="manager">
    <span class="avatar" aria-hidden="true">{t('panel.managerInitial')}</span>
    <span class="who">
      <strong>{t('panel.managerName')}</strong>
      <span>{t('panel.managerRole')}</span>
    </span>
  </div>
</aside>

<style>
  .side {
    flex: 1 1 260px;
    max-width: 100%;
    background: var(--white);
    border-right: 1px solid var(--line);
    padding: 28px 18px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 0 12px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-name {
    font-size: 30px;
  }

  /* Design: 13px; 15px (CLAUDE.md minimum for real text) */
  .brand-sub {
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  nav a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 0 16px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    font-size: 18px;
  }

  nav a[href]:hover,
  nav a.is-pending:hover {
    background: var(--row-hover);
  }

  nav a[aria-current] {
    background: var(--ink);
    color: var(--white);
  }

  nav svg {
    flex: none;
  }

  .manager {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-top: 1px solid var(--line-panel);
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--soft-green-bg);
    color: var(--ok);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 15px;
    flex: none;
  }

  .who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .who strong {
    font-size: 16px;
    color: var(--ink);
  }

  .who span {
    font-size: 15px;
    color: var(--muted);
  }

  /* Tablet and mobile: the side menu becomes a top bar with
     horizontal navigation (scroll only inside the menu, never the whole page). */
  @media (max-width: 1040px) {
    .side {
      flex-basis: 100%;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 20px 20px 12px;
      gap: 14px;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .brand {
      padding: 0;
    }

    .manager {
      margin: 0;
      padding: 0;
      border: 0;
    }

    nav {
      grid-column: 1 / -1;
      /* positioned: so absolute children (.sr-only) stay clipped inside the nav */
      position: relative;
      overflow-x: auto;
      scrollbar-width: thin;
      margin: 0 -20px;
      padding: 0 20px 6px;
    }

    ul {
      flex-direction: row;
      width: max-content;
    }

    nav a {
      white-space: nowrap;
      min-height: 48px;
      font-size: 17px;
    }
  }
</style>

<script>
  // Compact (horizontal) menu: makes the current entry visible without moving the page.
  document.addEventListener('astro:page-load', () => {
    const nav = document.querySelector<HTMLElement>('aside.side nav');
    const current = nav?.querySelector<HTMLElement>('a[aria-current]');
    if (!nav || !current || nav.scrollWidth <= nav.clientWidth) return;
    nav.scrollLeft = current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2;
  });
</script>
