---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import silverTexture from '../assets/images/texture-silver.jpg';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { getLangFromUrl, publishedLanguages, switchLangPath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Site footer: full (Inicio), compact (Extras, Bodas, Blog, Reserva), none (Acceso, Panel). */
  footer?: 'full' | 'compact' | 'none';
  /** The header is always fixed. site: the content starts below it (padding-top).
      overlay: the content starts at the top, under the header (Inicio, its hero compensates).
      none: no general header (prepared for /acceso, which has its own header in the design). */
  header?: 'site' | 'overlay' | 'none';
  /** false: the page provides its own <main id="main-content"> (Acceso, Panel: own structure). */
  wrapMain?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// PROVISIONAL: 'site.description' is a temporary meta description (based on the hero
// subtitle), pending final text.
const {
  title,
  description = t('site.description'),
  footer = 'full',
  header = 'site',
  wrapMain = true,
} = Astro.props;

const siteName = t('site.name');
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
// hreflang only for versions that exist (unpublished languages would point to a 404).
const alternates = publishedLanguages.map((code) => ({
  code,
  href: new URL(switchLangPath(Astro.url.pathname, code), Astro.site).href,
}));

// Gray texture: optimized version, applied as background in ::before (global.css)
const silver = await getImage({ src: silverTexture, width: 1600, format: 'webp', quality: 70 });
// og:locale in language_TERRITORY format. PENDING DECISION: territory for English.
const ogLocale = { es: 'es_ES', en: 'en', fr: 'fr_FR', ru: 'ru_RU' }[lang];
const textureVars = `--tex-silver: url("${silver.src}");`;
---

<!doctype html>
<html lang={lang} style={textureVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.code} href={alt.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternates.find((alt) => alt.code === 'es')?.href}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocale} />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t('a11y.skip')}
    </a>
    {header !== 'none' && <Header />}
    {wrapMain ? (
      <main
        id="main-content"
        class:list={{ 'under-header': header === 'site' }}
        transition:animate={fade({ duration: '300ms' })}
      >
        <slot />
      </main>
    ) : (
      <slot />
    )}
    {footer !== 'none' && <Footer variant={footer} />}
  </body>
</html>
