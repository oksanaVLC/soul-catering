---
// /panel/invitados: guest panel (design 06). DEMO: example data, without backend or
// persistence, and WITHOUT real protection (there is no authentication or roles: PENDING DECISION).
// The header actions (import, export, add) have no defined behavior: they keep their
// appearance and are marked as not available.
import PanelLayout from '../../layouts/PanelLayout.astro';
import GuestTable from '../../components/panel/GuestTable.astro';
import { demoEvent, demoGuests } from '../../data/guests';
import { countGuests } from '../../lib/panel/guests';
import { formatMediumDate } from '../../lib/dates';
import { formatCents, percentOfCents } from '../../lib/money';
import { DEPOSIT_PERCENT, DEPOSIT_ROUNDING_CENTS, LOCALE } from '../../data/config';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const counts = countGuests(demoGuests);
// Amount paid = DEMO deposit on the example total (design: 1.200 € of 4.000 €, 30 %).
const paid = percentOfCents(demoEvent.totalCents, DEPOSIT_PERCENT, DEPOSIT_ROUNDING_CENTS);
const eur = (cents: number) => formatCents(cents, { locale: LOCALE, grouping: true });
const paidPercent = Math.round((paid / demoEvent.totalCents) * 100);

const actions = [
  { key: 'panel.import', primary: false, icon: '<path d="M12 15V3M7 8l5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>' },
  { key: 'panel.export', primary: false, icon: '<path d="M12 3v12M7 10l5 5 5-5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>' },
  { key: 'panel.add', primary: true, icon: '<path d="M12 5v14M5 12h14"/>' },
] as const;
const stats = [
  { key: 'panel.countTotal', value: counts.total, tone: '' },
  { key: 'panel.countConfirmed', value: counts.confirmed, tone: 'ok' },
  { key: 'panel.countPending', value: counts.pending, tone: 'wait' },
  { key: 'panel.countAllergies', value: counts.withAllergies, tone: '' },
] as const;
---

<PanelLayout title={t('panel.title')}>
  <div class="head">
    <div class="titles">
      <nav aria-label={t('common.breadcrumb')} class="crumbs">
        <a class="is-pending">{t('panel.breadcrumbBookings')}<span class="sr-only"> {t('a11y.pending')}</span></a>
        <span aria-hidden="true">/</span>
        <span>{demoEvent.name}</span>
      </nav>
      <h1>{t('panel.title')}</h1>
    </div>
    <div class="actions">
      {
        actions.map((a) => (
          <button type="button" class:list={['pbtn', a.primary ? 'primary' : 'ghost']} aria-disabled="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={a.primary ? 2 : 1.8} stroke-linecap="round" aria-hidden="true" set:html={a.icon} />
            {t(a.key)}
            <span class="sr-only"> {t('a11y.pending')}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- DEMO: event and payments of the example design -->
  <section class="card event" aria-label={t('panel.eventLabel')}>
    <dl class="facts">
      <div>
        <dt>{t('panel.eventDate')}</dt>
        <dd>{formatMediumDate(demoEvent.date, LOCALE)} · {demoEvent.time}</dd>
      </div>
      <div>
        <dt>{t('panel.eventPlace')}</dt>
        <dd>{demoEvent.venue}</dd>
      </div>
      <div>
        <dt>{t('panel.eventMenu')}</dt>
        <dd>{demoEvent.menu}</dd>
      </div>
    </dl>
    <div class="pay">
      <div class="pay-row">
        <span class="paid">{t('panel.paid', { amount: eur(paid) })}</span>
        <span>{t('panel.remaining', { rest: eur(demoEvent.totalCents - paid), total: eur(demoEvent.totalCents) })}</span>
      </div>
      <div class="bar" aria-hidden="true"><div style={`width:${paidPercent}%`}></div></div>
    </div>
  </section>

  <section class="stats" aria-label={t('panel.countersLabel')}>
    {
      stats.map((s) => (
        <div class="card stat">
          <div class="stat-label">{t(s.key)}</div>
          <div class:list={['serif stat-value', s.tone]}>{s.value}</div>
        </div>
      ))
    }
  </section>

  <GuestTable guests={demoGuests} />
</PanelLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .crumbs {
    font-size: 16px;
    color: var(--muted);
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
  }

  .crumbs a {
    text-decoration: underline;
    color: var(--ink);
  }

  h1 {
    font-size: 48px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    font: 600 17px var(--font-sans);
    border: 1.5px solid transparent;
    white-space: nowrap;
    cursor: not-allowed;
  }

  .primary {
    background: var(--ink);
    color: var(--white);
  }

  .ghost {
    border-color: var(--field-border-a11y);
    background: var(--white);
    color: var(--ink);
  }

  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .event {
    padding: 28px 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 28px 48px;
    align-items: center;
    justify-content: space-between;
  }

  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 20px 44px;
  }

  dt {
    font-size: 15px;
    color: var(--muted);
    font-weight: 600;
  }

  dd {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
  }

  .pay {
    flex: 0 1 340px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 240px;
  }

  .pay-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 16px;
    color: var(--muted);
  }

  .paid {
    font-weight: 600;
    color: var(--ink);
  }

  .bar {
    height: 10px;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }

  .bar div {
    height: 100%;
    background: var(--ink);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: 16px;
  }

  .stat {
    padding: 22px 24px;
  }

  .stat-label {
    font-size: 16px;
    color: var(--muted);
    font-weight: 600;
  }

  .stat-value {
    font-size: 48px;
  }

  .stat-value.ok {
    color: var(--ok);
  }

  .stat-value.wait {
    color: var(--wait);
  }

  @media (max-width: 1040px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 700px) {
    h1 {
      font-size: 42px;
    }

    .actions {
      width: 100%;
    }

    .pbtn {
      flex: 1 1 100%;
    }

    .event {
      padding: 22px 20px;
    }

    .pay {
      flex-basis: 100%;
      min-width: 0;
    }

    .stats {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .stat {
      padding: 16px 18px;
    }

    .stat-value {
      font-size: 40px;
    }
  }
</style>
