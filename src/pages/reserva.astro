---
// /reserva: ONE page with six sections and anchor navigation (approved decision).
// No real payment, email or calendar. The final screen «Solicitud recibida» is simulated
// and prepares the future sequence: request → email → deposit payment.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/booking/BookingForm.astro';
import Summary from '../components/booking/Summary.astro';
import Button from '../components/ui/Button.astro';
import lavanda from '../assets/images/lavanda.webp';
import { bookingCatalog } from '../data/booking-catalog';
import { BOOKING_DEFAULTS, reservationConfig } from '../data/config';
import { calculateSummary } from '../lib/reservation/summary';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));

// Initial summary: the same function the store uses in the browser (derived, not copied).
const initialSummary = calculateSummary(BOOKING_DEFAULTS, bookingCatalog, reservationConfig);
const steps = [1, 2, 3, 4, 5, 6] as const;
---

<BaseLayout title={t('booking.title')} footer="compact">
  <section class="done" hidden data-booking-done aria-labelledby="done-title">
    <div class="container done-inner">
      <div class="done-icon" aria-hidden="true">
        <svg
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg
        >
      </div>
      <h1 id="done-title" tabindex="-1">{t('booking.doneTitle')}</h1>
      <p class="done-text">
        {t('booking.doneTextBefore')} <strong data-done-date></strong>.
      </p>
      <p class="hint">{t('booking.demoNote')}</p>
      <Button data-booking-back>{t('booking.doneBack')}</Button>
    </div>
  </section>

  <section class="booking" data-booking-main>
    <div class="photo" aria-hidden="true">
      <Image src={lavanda} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" />
    </div>
    <div class="container inner">
      <div class="intro">
        <p class="eyebrow">{t('booking.eyebrow')}</p>
        <h1 class="h1">{t('booking.h1')}</h1>
        <p class="lead-text">{t('booking.lead')}</p>
      </div>

      <nav aria-label={t('booking.stepsLabel')}>
        <ol class="steps-nav">
          {
            steps.map((n) => (
              <li>
                <a href={`#paso-${n}`} aria-current={n === 1 ? 'step' : undefined} data-step-link={n}>
                  {n} · {t(`booking.nav${n}`)}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="layout">
        <BookingForm />
        <Summary summary={initialSummary} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .booking {
    position: relative;
    padding: 360px 0 120px;
    background: var(--bg);
  }

  .photo {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 640px;
    overflow: hidden;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(246, 242, 233, 0) 0%,
      rgba(246, 242, 233, 0) 35%,
      rgba(246, 242, 233, 0.8) 70%,
      var(--bg) 100%
    );
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
  }

  .h1 {
    font-size: clamp(46px, 5vw, 72px);
  }

  .lead-text {
    font-size: 21px;
    color: var(--text-2);
  }

  .steps-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    font-size: 17px;
    font-weight: 600;
  }

  .steps-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  .steps-nav a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .steps-nav a[aria-current] {
    color: var(--ink);
  }

  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
  }

  .done {
    padding: 120px 0;
  }

  .done-inner {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .done-icon {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--soft-green-bg);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .done h1 {
    font-size: 56px;
  }

  .done h1:focus {
    outline: none;
  }

  .done h1:focus-visible {
    outline: 3px solid var(--accent);
  }

  .done-text {
    font-size: 21px;
  }

  @media (max-width: 900px) {
    /* The text starts in the area already covered by the gradient (as on desktop: ~60 %) */
    .booking {
      padding-top: 270px;
    }

    .photo {
      height: 380px;
    }

    .inner {
      gap: 32px;
    }
  }

  @media (max-width: 700px) {
    .done h1 {
      font-size: 44px;
    }
  }
</style>

<script>
  import { formatLongDate } from '../lib/dates';
  import { LOCALE } from '../data/config';

  document.addEventListener('astro:page-load', () => {
    const main = document.querySelector<HTMLElement>('[data-booking-main]');
    const done = document.querySelector<HTMLElement>('[data-booking-done]');
    if (!main || !done) return;

    // Simulated confirmation screen
    main.addEventListener('booking:done', ((e: CustomEvent<{ date: string | null }>) => {
      const date = done.querySelector('[data-done-date]');
      if (date) date.textContent = e.detail.date ? formatLongDate(e.detail.date, LOCALE) : '';
      main.hidden = true;
      done.hidden = false;
      window.scrollTo({ top: 0 });
      done.querySelector<HTMLElement>('#done-title')?.focus();
    }) as EventListener);
    done.querySelector('[data-booking-back]')?.addEventListener('click', () => {
      // The form store goes back to «editing» (the data entered is kept).
      main.querySelector('form')?.dispatchEvent(new CustomEvent('booking:back'));
      done.hidden = true;
      main.hidden = false;
      window.scrollTo({ top: 0 });
    });

    // Active step in the anchor navigation
    const links = [...main.querySelectorAll<HTMLAnchorElement>('[data-step-link]')];
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const n = (entry.target as HTMLElement).dataset.step;
          links.forEach((l) =>
            l.dataset.stepLink === n ? l.setAttribute('aria-current', 'step') : l.removeAttribute('aria-current'),
          );
        });
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    main.querySelectorAll('fieldset[data-step]').forEach((step) => observer.observe(step));
  });
</script>
